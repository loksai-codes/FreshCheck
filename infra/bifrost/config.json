{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {"enable_logging": true, "drop_excess_requests": false, "enforce_auth_on_inference": true},
  "providers": {
    "groq": {"keys": [{"name": "groq-primary", "value": "env.GROQ_API_KEY", "models": ["*"], "weight": 1.0}]},
    "openai": {"keys": [{"name": "optional-fallback", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 0.1}]}
  },
  "governance": {
    "virtual_keys": [{
      "id": "freshcheck-local",
      "name": "FreshCheck local",
      "value": "env.BIFROST_API_KEY",
      "is_active": true,
      "provider_configs": [
        {"provider": "groq", "allowed_models": ["*"], "key_ids": ["*"], "weight": 1.0},
        {"provider": "openai", "allowed_models": ["*"], "key_ids": ["*"], "weight": 0.1}
      ],
      "budgets": [{"max_limit": 5.0, "reset_duration": "1d"}]
    }]
  },
  "config_store": {"enabled": true}
}
